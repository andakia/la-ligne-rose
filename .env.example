# Copy to .env and fill in. Never commit .env.

# Andakia Voice API (external service, not part of this repository)
ANDAKIA_API_URL=https://api.example.com
ANDAKIA_API_KEY=demo-key-not-real
ANDAKIA_API_TIMEOUT_S=15

# Public URL of this service, as seen by the voice gateway
PUBLIC_BASE_URL=http://localhost:8080
HOST=localhost
PORT=8080

# Where calls are transferred when a caller asks for a health professional.
# Empty = no transfer: the caller hears that nobody is available.
HUMAN_TRANSFER_TARGET=sip:health-desk@pbx.example.com

# Voice assistant turns per call before a polite goodbye
MAX_AI_TURNS=12
AUDIO_SAMPLE_RATE=8000

# Call journal. Caller numbers are stored as a salted hash only.
CALL_LOG_PATH=data/calls.sqlite3
CALLER_HASH_SALT=change-me
# Keep false unless callers have given explicit consent.
LOG_TRANSCRIPTS=false

# Enables GET /stats (aggregated counts only) when set
ADMIN_TOKEN=
